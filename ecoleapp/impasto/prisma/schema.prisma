// ===========================================================================
//  Impasto — Schéma de base de données (Prisma + PostgreSQL)
//  ERP de formation pour l'École Pizza Jean-Jacques Despaux.
//  Multi-tenant : presque tous les modèles portent un organizationId.
// ===========================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ----------------------------- ENUMS ---------------------------------------

enum Role {
  SUPER_ADMIN
  ADMIN_ORGANISME
  SECRETARIAT
  FORMATEUR
  STAGIAIRE
  ENTREPRISE
  FINANCEUR
  AUDITEUR
}

enum Financement {
  PARTICULIER     // contrat de formation, devis particulier
  PROFESSIONNEL   // convention de formation, devis entreprise, OPCO
}

enum SessionStatus {
  PLANIFIEE
  CONFIRMEE
  EN_COURS
  TERMINEE
  ANNULEE
}

// Pipeline CRM (point 11 du cahier des charges)
enum CrmStage {
  PROSPECT
  CONTACTE
  DEVIS_ENVOYE
  DEVIS_SIGNE
  ACOMPTE_PAYE
  INSCRIT
  EN_FORMATION
  TERMINE
  EVALUATION_ENVOYEE
  ARCHIVE
}

enum DocumentType {
  PROGRAMME
  FICHE_SEMAINE
  TEST_POSITIONNEMENT
  DEVIS
  CONTRAT
  CONVENTION
  CONVOCATION
  INVITATION
  DROIT_IMAGE
  EMARGEMENT
  ATTESTATION_HYGIENE
  CERTIFICAT_REALISATION
  CGV
  EVALUATION_FINANCEUR
  EVALUATION_MANAGEUR
}

enum DocumentStatus {
  A_FAIRE
  GENERE
  ENVOYE
  CONSULTE
  SIGNE
  ARCHIVE
}

enum SignatureProvider {
  YOUSIGN
}

enum SignatureLevel {
  SIMPLE
  AVANCEE
  QUALIFIEE
}

enum SignatureAuth {
  OTP_EMAIL
  OTP_SMS
}

enum SignatureStatus {
  BROUILLON
  ENVOYEE
  EN_COURS
  SIGNEE
  REFUSEE
  EXPIREE
}

enum RecipientRole {
  STAGIAIRE
  ENTREPRISE
  ORGANISME
}

enum RecipientStatus {
  EN_ATTENTE
  SIGNE
  REFUSE
}

enum AttendanceSlot {
  MATIN
  APRES_MIDI
  EXAMEN
  DISTANCIEL
}

enum InvoiceType {
  DEVIS
  ACOMPTE
  FACTURE
  AVOIR
}

enum InvoiceStatus {
  BROUILLON
  EMISE
  PAYEE
  IMPAYEE
  ANNULEE
}

enum PaymentStatus {
  EN_ATTENTE
  REUSSI
  ECHOUE
  REMBOURSE
}

enum EvaluationType {
  POSITIONNEMENT
  FORMATIVE
  SATISFACTION_CHAUD
  SATISFACTION_FROID
  FINANCEUR
  MANAGEUR
}

enum QualiopiStatus {
  MANQUANT
  PRESENT
  NON_APPLICABLE
}

enum ConformiteScore {
  VERT     // dossier complet
  ORANGE   // pièces manquantes non bloquantes
  ROUGE    // pièces obligatoires manquantes
}

enum NotificationType {
  INFO
  RELANCE
  SIGNATURE
  PAIEMENT
  QUALIOPI
  SYSTEME
}

enum WebhookSource {
  YOUSIGN
  STRIPE
  GOOGLE
  ZAPIER
}

// --------------------------- ORGANISATION ----------------------------------

model Organization {
  id            String   @id @default(cuid())
  raisonSociale String
  sigle         String?
  responsable   String?
  siret         String?
  nda           String?  // n° déclaration d'activité
  nafApe        String?
  adresse       String?
  codePostal    String?
  ville         String?
  telephone     String?
  email         String?
  qualiopi      Boolean  @default(false)
  juridiction   String?
  // Intégrations (références, jamais de secrets en clair ici)
  googleDriveRootId String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  users        User[]
  learners     Learner[]
  companies    Company[]
  programs     TrainingProgram[]
  sessions     TrainingSession[]
  templates    DocumentTemplate[]
  documents    GeneratedDocument[]
  signatures   SignatureRequest[]
  invoices     Invoice[]
  evaluations  Evaluation[]
  auditLogs    AuditLog[]
  notifications Notification[]
  webhookEvents WebhookEvent[]
  apiKeys      ApiKey[]
  partners     Partner[]
}

// ------------------------------- USER --------------------------------------
// Compatible adaptateur NextAuth/Auth.js (Account, Session, VerificationToken).

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  role           Role      @default(SECRETARIAT)
  passwordHash   String?   // accès stagiaire généré par le secrétariat
  accessSentAt   DateTime?
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  // liens optionnels vers les profils métier
  learnerId      String?   @unique
  learner        Learner?  @relation(fields: [learnerId], references: [id])
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])

  accounts       Account[]
  sessions       Session[]
  attendance     AttendanceRecord[]
  notifications  Notification[]
  auditLogs      AuditLog[]
  trainerSessions TrainingSession[] @relation("SessionFormateur")

  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  @@index([organizationId])
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ------------------------------ LEARNER ------------------------------------
// Stagiaire — reprend les champs de la feuille « Data ».

model Learner {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])

  civilite       String?
  nom            String
  prenom         String?
  dateNaissance  DateTime?
  lieuNaissance  String?
  telephone      String?
  email          String?
  adresse        String?
  codePostal     String?
  ville          String?
  // parcours
  diplomeNiveau  String?
  diplomeNom     String?
  diplomeAnnee   String?
  experience     String?
  statut         String?   // « Êtes-vous ? » : En activité, Demandeur d'emploi…
  cpf            String?
  idPoleEmploi   String?
  numeroSecu     String?
  // financement & entreprise
  financement    Financement @default(PARTICULIER)
  companyId      String?
  company        Company?  @relation(fields: [companyId], references: [id])
  opco           String?

  // Carte & données historiques (import carte des stagiaires)
  lat            Float?
  lng            Float?
  departement    String?
  niveauRealise  String?   // formation suivie (vide = à compléter / à recontacter)
  anneeRealisee  String?
  entrepriseNom  String?   // entreprise (dénormalisée, import)
  aRecontacter   Boolean  @default(false)
  importSource   String?

  user           User?
  enrollments    Enrollment[]
  attendance     AttendanceRecord[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ------------------------------ COMPANY ------------------------------------
// Entreprise / financeur.

model Company {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  nom            String
  siret          String?
  nafApe         String?
  adresse        String?
  codePostal     String?
  ville          String?
  telephone      String?
  email          String?
  opco           String?
  civRepresentant String?
  nomRepresentant String?

  learners       Learner[]
  users          User[]
  enrollments    Enrollment[]
  invoices       Invoice[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// --------------------------- TRAINING PROGRAM ------------------------------
// Formation — reprend la feuille « Programmes ».

model TrainingProgram {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  code           String   // NIV1, NIV1H, RS7404…
  titre          String
  jours          Int
  heures         Int
  prix           Decimal  @db.Decimal(10, 2)
  public         String?
  objectifs      String?  @db.Text
  objectifGeneral String? @db.Text
  deroule        String?  @db.Text
  dureeDetail    String?  @db.Text
  hygiene        Boolean  @default(false)
  rsCode         String?  // RS7404 si certifiante
  actif          Boolean  @default(true)
  ordre          Int      @default(0)   // position d'affichage (glisser-déposer)
  image          String?                // visuel du niveau (ex. /ecole/niv1.jpg)

  sessions       TrainingSession[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([organizationId, code])
}

// --------------------------- TRAINING SESSION ------------------------------

model TrainingSession {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  programId      String
  program        TrainingProgram @relation(fields: [programId], references: [id])
  annee          Int
  semaine        Int      // n° de semaine ISO
  dateDebut      DateTime?
  dateFin        DateTime?
  formateurId    String?
  formateur      User?    @relation("SessionFormateur", fields: [formateurId], references: [id])
  status         SessionStatus @default(PLANIFIEE)
  googleCalendarEventId String?

  enrollments    Enrollment[]
  attendanceSheets AttendanceSheet[]
  qualiopiEvidence QualiopiEvidence[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, annee, semaine])
}

// ----------------------------- ENROLLMENT ----------------------------------
// Inscription d'un stagiaire à une session : le « dossier ».

model Enrollment {
  id             String   @id @default(cuid())
  learnerId      String
  learner        Learner  @relation(fields: [learnerId], references: [id])
  sessionId      String
  session        TrainingSession @relation(fields: [sessionId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  financement    Financement @default(PARTICULIER)
  prix           Decimal? @db.Decimal(10, 2)
  acompte        Decimal? @db.Decimal(10, 2)
  crmStage       CrmStage @default(INSCRIT)
  leadSource     String?
  conformite     ConformiteScore @default(ROUGE)
  // Jalons du pipeline (blocage strict avant « Inscrit »)
  devisSigne     Boolean  @default(false)
  acompteRecu    Boolean  @default(false)
  // Financement : montant pris en charge par un tiers (OPCO, France Travail…).
  // Reste à charge = prix - priseEnCharge - acompte (complément payé pendant la formation).
  priseEnCharge  Decimal? @db.Decimal(10, 2)

  documents      GeneratedDocument[]
  signatures     SignatureRequest[]
  invoices       Invoice[]
  evaluations    Evaluation[]
  qualiopiEvidence QualiopiEvidence[]
  notes          EnrollmentNote[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([learnerId, sessionId])
  @@index([crmStage])
}

model EnrollmentNote {
  id           String   @id @default(cuid())
  enrollmentId String
  enrollment   Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  authorId     String?
  body         String   @db.Text
  reminderAt   DateTime?
  createdAt    DateTime @default(now())
}

// ------------------------- DOCUMENT TEMPLATES ------------------------------

model DocumentTemplate {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  type           DocumentType
  name           String   // ex. « Devis Particulier_.docx »
  storageKey     String?  // clé Drive/S3 du .docx modèle
  // conditions d'application (ex. {"financement":"PARTICULIER"} ou {"rsCode":"RS7404"})
  conditions     Json?
  variables      String[] // jetons attendus : {Personne}, {Adresse}…
  version        String   @default("1.0")
  actif          Boolean  @default(true)

  documents      GeneratedDocument[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, type])
}

// ------------------------- GENERATED DOCUMENT ------------------------------

model GeneratedDocument {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id])
  templateId     String?
  template       DocumentTemplate? @relation(fields: [templateId], references: [id])
  type           DocumentType
  status         DocumentStatus @default(A_FAIRE)
  numberPrefix   String?  // « 4 », « 5 »…
  fileName       String?
  docxKey        String?  // stockage du DOCX
  pdfKey         String?  // stockage du PDF
  driveFileId    String?
  mergeData      Json?    // variables de fusion utilisées (traçabilité)

  signatureRequest SignatureRequest?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, type])
  @@index([enrollmentId])
}

// ------------------------- SIGNATURE REQUEST -------------------------------

model SignatureRequest {
  id                 String   @id @default(cuid())
  organizationId     String
  organization       Organization @relation(fields: [organizationId], references: [id])
  enrollmentId       String?
  enrollment         Enrollment? @relation(fields: [enrollmentId], references: [id])
  documentId         String   @unique
  document           GeneratedDocument @relation(fields: [documentId], references: [id])
  provider           SignatureProvider @default(YOUSIGN)
  providerRequestId  String?  // ID Yousign
  level              SignatureLevel @default(SIMPLE)
  authMode           SignatureAuth  @default(OTP_EMAIL)
  status             SignatureStatus @default(BROUILLON)
  signedPdfKey       String?
  proofKey           String?  // dossier de preuve
  sentAt             DateTime?
  completedAt        DateTime?

  // Signature démo (workflow interne : lien + OTP + consentement + preuve)
  token             String?   @unique
  otpCode           String?
  otpSentAt         DateTime?
  consentAt         DateTime?
  signatureDataUrl  String?   @db.Text
  docHash           String?
  signerIp          String?
  signerUserAgent   String?
  proof             Json?

  recipients         SignatureRecipient[]

  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([organizationId, status])
}

model SignatureRecipient {
  id          String   @id @default(cuid())
  requestId   String
  request     SignatureRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  role        RecipientRole
  nom         String
  email       String?
  telephone   String?
  status      RecipientStatus @default(EN_ATTENTE)
  ordre       Int      @default(1)
  signedAt    DateTime?
}

// ----------------------------- ATTENDANCE ----------------------------------

model AttendanceSheet {
  id          String   @id @default(cuid())
  sessionId   String
  session     TrainingSession @relation(fields: [sessionId], references: [id])
  date        DateTime
  slot        AttendanceSlot
  records     AttendanceRecord[]
  pdfKey      String?
  createdAt   DateTime @default(now())

  @@unique([sessionId, date, slot])
}

model AttendanceRecord {
  id          String   @id @default(cuid())
  sheetId     String
  sheet       AttendanceSheet @relation(fields: [sheetId], references: [id], onDelete: Cascade)
  learnerId   String?
  learner     Learner? @relation(fields: [learnerId], references: [id])
  trainerId   String?
  trainer     User?    @relation(fields: [trainerId], references: [id])
  present     Boolean  @default(false)
  signedAt    DateTime?
  signatureImageKey String?
  ip          String?
  device      String?

  @@index([sheetId])
}

// ------------------------------ INVOICE ------------------------------------

model Invoice {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  enrollmentId   String?
  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id])
  companyId      String?
  company        Company? @relation(fields: [companyId], references: [id])
  type           InvoiceType
  number         String   @unique
  amountNet      Decimal  @db.Decimal(10, 2)
  tvaExoneree    Boolean  @default(true) // art. 261-4-4° du CGI
  status         InvoiceStatus @default(BROUILLON)
  dueDate        DateTime?
  pdfKey         String?

  payments       Payment[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, status])
}

model Payment {
  id          String   @id @default(cuid())
  invoiceId   String
  invoice     Invoice  @relation(fields: [invoiceId], references: [id])
  provider    String   @default("stripe")
  providerPaymentId String?
  amount      Decimal  @db.Decimal(10, 2)
  status      PaymentStatus @default(EN_ATTENTE)
  paidAt      DateTime?
  createdAt   DateTime @default(now())

  @@index([invoiceId])
}

// ---------------------------- EVALUATION -----------------------------------

model Evaluation {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  enrollmentId   String
  enrollment     Enrollment @relation(fields: [enrollmentId], references: [id])
  type           EvaluationType
  payload        Json?    // réponses (issues du Google Form / QCM)
  score          Float?
  submittedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([enrollmentId, type])
}

// -------------------------- QUALIOPI EVIDENCE ------------------------------

model QualiopiEvidence {
  id             String   @id @default(cuid())
  sessionId      String?
  session        TrainingSession? @relation(fields: [sessionId], references: [id])
  enrollmentId   String?
  enrollment     Enrollment? @relation(fields: [enrollmentId], references: [id])
  indicator      String   // ex. « Programme transmis », « Émargement »…
  status         QualiopiStatus @default(MANQUANT)
  documentId     String?
  note           String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([sessionId])
}

// ------------------------------ AUDIT LOG ----------------------------------

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  action         String   // ex. « document.generate »
  entity         String   // ex. « GeneratedDocument »
  entityId       String?
  metadata       Json?
  ip             String?
  // Chaîne d'intégrité (tamper-evident) : hash de cet événement + hash du précédent.
  hash           String?
  prevHash       String?
  createdAt      DateTime @default(now())

  @@index([organizationId, entity])
  @@index([createdAt])
}

// ----------------------------- NOTIFICATION --------------------------------

model Notification {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  userId         String?
  user           User?    @relation(fields: [userId], references: [id])
  type           NotificationType @default(INFO)
  title          String
  body           String?
  read           Boolean  @default(false)
  createdAt      DateTime @default(now())

  @@index([userId, read])
}

// ---------------------------- WEBHOOK EVENT --------------------------------

model WebhookEvent {
  id             String   @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  source         WebhookSource
  eventType      String?
  payload        Json
  signatureValid Boolean  @default(false)
  processedAt    DateTime?
  createdAt      DateTime @default(now())

  @@index([source, eventType])
}

// ------------------------------- API KEY -----------------------------------

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  name           String
  keyHash        String   @unique // on ne stocke jamais la clé en clair
  lastUsedAt     DateTime?
  revokedAt      DateTime?
  createdAt      DateTime @default(now())

  @@index([organizationId])
}

// ============================================================================
//  PARTENAIRES (point « Contrat partenaires »)
//  Annuaire des partenaires commerciaux de l'école (fournisseurs farine,
//  matériel, charcuterie, fours…) + suivi des contrats de partenariat.
// ============================================================================

enum PartnerCategory {
  FARINE
  MATERIEL
  FOUR
  CHARCUTERIE
  FROMAGE
  CONSERVE
  DISTRIBUTION
  AUTRE
}

enum PartnerContractStatus {
  PROSPECT
  EN_NEGOCIATION
  ACTIF
  EXPIRE
  RESILIE
}

model Partner {
  id             String   @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id])
  nom            String
  categorie      PartnerCategory @default(AUTRE)
  contactNom     String?
  contactEmail   String?
  contactTel     String?
  siteWeb        String?
  ville          String?
  notes          String?  @db.Text
  remisePct      Float?   // remise négociée pour l'école / les stagiaires
  logoKey        String?

  contracts      PartnerContract[]

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId, categorie])
}

model PartnerContract {
  id          String   @id @default(cuid())
  partnerId   String
  partner     Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  titre       String
  status      PartnerContractStatus @default(PROSPECT)
  dateDebut   DateTime?
  dateFin     DateTime?
  montant     Decimal? @db.Decimal(10, 2)
  documentKey String?  // contrat signé (Drive/S3)
  signed      Boolean  @default(false)

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([partnerId, status])
}

// ------------------------------ VENTES MATÉRIEL ----------------------------
// Suivi des ventes de matériel (fours, pétrins, matières premières, accessoires)
// aux stagiaires / débouchés. Saisie manuelle par le secrétariat.
model MaterialSale {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @default(now())
  produit        String
  categorie      String   // Four, Pétrin, Matière première, Accessoire, Livre, Autre
  quantite       Int      @default(1)
  montant        Decimal  @db.Decimal(10, 2)
  learnerId      String?
  learnerNom     String?
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// ------------------------- COMPTABILITÉ / GESTION --------------------------
// Tableau de gestion (module A) — PAS de la comptabilité légale.
// CA = inscriptions (Enrollment.prix) + ventes matériel (MaterialSale) + RevenueExtra.

enum ExpenseCategory {
  MATIERES_PREMIERES
  SALAIRES
  LOYER
  MARKETING
  ENERGIE
  DIVERS
}

// Dépense (poste de gestion). fournisseurId reste un String libre tant que le
// module Approvisionnement (Supplier) n'existe pas.
model Expense {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @default(now())
  categorie      ExpenseCategory
  libelle        String
  montantHT      Decimal  @db.Decimal(10, 2)
  fournisseurId  String?
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([date])
}

// Produits divers hors inscriptions et hors ventes de matériel (MaterialSale) :
// commissions partenaires, subventions, remboursements… Évite le double-comptage.
model RevenueExtra {
  id             String   @id @default(cuid())
  organizationId String
  date           DateTime @default(now())
  libelle        String
  categorie      String   @default("COMMISSION") // COMMISSION | SUBVENTION | AUTRE
  montant        Decimal  @db.Decimal(10, 2)
  note           String?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
  @@index([date])
}

// Cibles de gestion éditables par organisme (défauts dans src/lib/compta/targets.ts).
// targets = { MATIERES_PREMIERES: 27.5, SALAIRES: 30, ... } en % du CA.
model AccountingSettings {
  id             String   @id @default(cuid())
  organizationId String   @unique
  targets        Json
  dividendeCible Decimal  @default(10) @db.Decimal(5, 2)

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}
