# ==========================================================================
#  Impasto — variables d'environnement (copier en .env.local et remplir)
#  NE JAMAIS committer .env.local ni de secret réel.
# ==========================================================================

# Base de données PostgreSQL
DATABASE_URL="postgresql://impasto:impasto@localhost:5432/impasto?schema=public"

# NextAuth / Auth.js
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="" # openssl rand -base64 32

# Connexion Google (Drive, Gmail, Calendar, Sheets)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
# Scopes : drive.file gmail.send calendar spreadsheets.readonly

# Yousign (signature électronique) — API v3
YOUSIGN_API_KEY=""
YOUSIGN_API_BASE="https://api-sandbox.yousign.app/v3" # prod : https://api.yousign.app/v3
YOUSIGN_WEBHOOK_SECRET=""

# Stripe (paiements)
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""

# Stockage (si S3 au lieu de Drive)
S3_ENDPOINT=""
S3_BUCKET=""
S3_ACCESS_KEY=""
S3_SECRET_KEY=""

# Conversion PDF (LibreOffice headless via Gotenberg, optionnel)
GOTENBERG_URL="http://localhost:3001"
