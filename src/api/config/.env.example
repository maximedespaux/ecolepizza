# ─────────────────────────────────────────────────────────────────────────────────────────────
# MODÈLE DE CONFIGURATION — copier en `config/.env`, qui n'est JAMAIS versionné.
#
#     cp config/.env.example config/.env
#
# Ce fichier ne contient que des exemples. Aucune valeur réelle ne doit y entrer : il est suivi
# par git, et un secret committé reste dans l'historique même après suppression.
# ─────────────────────────────────────────────────────────────────────────────────────────────

# --- Base de données (MariaDB 10.7 minimum) ---
# 10.7 n'est pas un confort : 34 migrations déclarent `DEFAULT uuid()`, une fonction que les
# versions antérieures refusent à la création de table. Vérifier avec `SELECT VERSION();`.
DB_HOST=127.0.0.1
DB_USER_ADMIN=impastio
DB_PASSWORD_ADMIN=
DB_NAME_ADMIN=impastio

# --- Jetons de session ---
# Chaîne longue et aléatoire. La changer déconnecte tout le monde immédiatement (les jetons
# déjà émis deviennent invérifiables) — ce qui est exactement ce qu'on veut en cas de fuite.
#   openssl rand -base64 48
JWT_SECRET=

# --- Chiffrement des numéros de sécurité sociale ---
# 64 caractères hexadécimaux, ni plus ni moins. EN PRODUCTION, L'API REFUSE DE DÉMARRER SANS :
# c'est délibéré, une clé absente ferait chiffrer des données nominatives avec une clé publique
# écrite dans le code source.
#   openssl rand -hex 32
#
# ⚠ ELLE NE SE CHANGE PAS APRÈS COUP. Les numéros déjà chiffrés (`enc:…`) ne se déchiffrent
# qu'avec la clé qui les a produits ; en changer rend les anciens définitivement illisibles.
SSN_ENC_KEY=

# --- Environnement ---
# `production` active deux choses : le cookie de session en `Secure` (donc HTTPS obligatoire,
# sinon plus personne ne se connecte), et le refus de démarrer sans SSN_ENC_KEY.
NODE_ENV=production
PORT=3000

# --- Derrière un reverse proxy (nginx, Traefik…) ---
# À 1, Express lit `X-Forwarded-For` pour connaître l'IP du client.
#
# ⚠ NE L'ACTIVER QUE SI UN PROXY RÉÉCRIT VRAIMENT CET EN-TÊTE. Sans proxy devant, n'importe qui
# peut envoyer l'en-tête qu'il veut : le limiteur anti-force brute compterait alors une identité
# neuve à chaque tentative, et ne se déclencherait jamais. Laisser vide en développement.
TRUST_PROXY=1

# --- Origines autorisées à appeler l'API ---
# Séparées par des virgules, SANS barre oblique finale. Le navigateur envoie
# `https://app.exemple.fr` : `https://app.exemple.fr/` ne lui est pas égal.
# Vide en développement → repli sur http://localhost:5173.
CORS_ORIGINS=https://app.exemple.fr

# --- LibreOffice ---
# Optionnel : le chemin est détecté seul (/usr/bin/soffice sur Linux). À ne renseigner que si
# l'installation est ailleurs. SANS LIBREOFFICE, AUCUN DOCUMENT NI FACTURE NE SE GÉNÈRE —
# `apt install libreoffice-writer` suffit, le paquet complet n'est pas nécessaire.
# SOFFICE_PATH=/usr/bin/soffice
